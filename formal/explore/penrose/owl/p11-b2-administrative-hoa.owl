<?xml version="1.0"?>
<rdf:RDF xmlns="http://score-theory.org/explore/penrose/p11-b2-administrative-hoa#"
     xml:base="http://score-theory.org/explore/penrose/p11-b2-administrative-hoa"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#">

    <!-- QUARANTINED EXPLORATION SANDBOX. Penrose P11 Pass B, B2 probe: an HOA that is also an administrative declaration (predicted consistent: nothing in core constrains an HOA).
         Registered (probe and prediction) in Penrose-P11 before this file was run. -->
    <owl:Ontology rdf:about="http://score-theory.org/explore/penrose/p11-b2-administrative-hoa">
        <owl:imports rdf:resource="http://score-theory.org/core"/>
        <rdfs:comment>expect: consistent</rdfs:comment>
    </owl:Ontology>
    <owl:Class rdf:about="http://score-theory.org/explore/penrose/p11-b2-administrative-hoa#AdministrativeDeclaration">
        <rdfs:comment>Probe class only: an HOA brought into being by declaration, the case the HOA note's prose excludes.</rdfs:comment>
    </owl:Class>
    <owl:NamedIndividual rdf:about="http://score-theory.org/explore/penrose/p11-b2-administrative-hoa#probeHOA">
        <rdf:type rdf:resource="http://score-theory.org/core#HOA"/>
        <rdf:type rdf:resource="http://score-theory.org/explore/penrose/p11-b2-administrative-hoa#AdministrativeDeclaration"/>
    </owl:NamedIndividual>
</rdf:RDF>
